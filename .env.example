LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
OPENAI_API_KEY=
# API root, including /v1 when required; do not append /responses or /chat/completions
OPENAI_BASE_URL=https://api.openai.com/v1
# responses for OpenAI; chat for compatible providers supporting structured JSON output
OPENAI_API_MODE=responses
OPENAI_MODEL=gpt-4.1-mini
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=line_tracker
# true for cloud MySQL, false for local only
MYSQL_SSL=false
# Optional PEM certificate; literal \n is supported
MYSQL_SSL_CA=
MYSQL_POOL_SIZE=3
# false if the provider creates the database and denies CREATE DATABASE
MYSQL_CREATE_DATABASE=true
APP_TIMEZONE=Asia/Bangkok
PORT=3000
